NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-04-09
SANITY_API_READ_TOKEN=your_read_token
# Required at runtime to store report/checklist download leads in Sanity.
# Also used by approved CMS maintenance scripts.
SANITY_API_WRITE_TOKEN=your_write_token

# Generate-once audio narration. Use the same strong webhook secret in
# Sanity Manage and in the deployed application environment.



# Contact form email delivery (Resend)
RESEND_API_KEY=re_your_api_key
CONTACT_FROM_EMAIL=HIDD Advisory <info@hiddadvisory.com>
CONTACT_TO_EMAIL=info@hiddadvisory.com

# Google Analytics 4 (example: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional. Without a key, the currency converter uses ExchangeRate-API's
# attributed open-access endpoint.
EXCHANGE_RATE_API_KEY=
